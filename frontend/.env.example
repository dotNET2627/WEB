# Public browser-safe URL of the ASP.NET Core API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5260

# Redis (patient session store). Leave empty to use in-memory store.
REDIS_URL=redis://localhost:6379

# Google OAuth (optional). Leave empty to use dev mock login.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
